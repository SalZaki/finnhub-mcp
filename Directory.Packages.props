<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <ModelContextProtocolVersion>1.4.0</ModelContextProtocolVersion>
    <MicrosoftExtensionsVersion>10.0.0</MicrosoftExtensionsVersion>
  </PropertyGroup>

  <ItemGroup Label="ModelContextProtocol">
    <PackageVersion Include="ModelContextProtocol" Version="$(ModelContextProtocolVersion)" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="$(ModelContextProtocolVersion)" />
  </ItemGroup>

  <ItemGroup Label="Common">
    <PackageVersion Include="DotNetEnv" Version="3.1.1" />
    <!--
      Held at >= 10.2.0. Swashbuckle.AspNetCore.Swagger 10.1.7 pulled in
      Microsoft.OpenApi 2.4.1, which GHSA-v5pm-xwqc-g5wc (high, CVSS 7.5,
      published 2026-06-30) covers; NuGet audit raises NU1903 and
      TreatWarningsAsErrors turns it into a restore failure. 10.2.3 requires
      Microsoft.OpenApi 2.7.5, the patched floor. Do not lower this.
    -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageVersion Include="Polly" Version="8.6.1" />
  </ItemGroup>

  <ItemGroup Label="Microsoft">
    <!--
      Held at >= 10.0.11 for the same advisory: 10.0.0 asked only for
      Microsoft.OpenApi >= 2.0.0, so it could not lift the vulnerable 2.4.1.
      10.0.11 constrains it to [2.7.5, 3.0.0) and matches the runtime CI uses.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11"/>
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>
  
  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.13.0"/>
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0"/>
    <PackageVersion Include="xunit" Version="2.9.3"/>
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2"/>
    <PackageVersion Include="coverlet.collector" Version="6.0.4"/>
    <PackageVersion Include="NSubstitute" Version="5.3.0"/>
  </ItemGroup>
</Project>
